  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,html,yml,css}": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --quiet"
    ]
  },
  "name": "u-choose",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "knip": "knip",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "prepare": "husky",
    "preview": "react-router-serve ./build/server/index.js",
    "release:dry": "semantic-release --dry-run --no-ci",
    "release:publish": "semantic-release",
    "set:version": "node --loader ts-node/esm --no-warnings=ExperimentalWarning ./scripts/set_version.ts",
    "tauri": "tauri",
    "typecheck": "react-router typegen && tsc"
  },
  "type": "module",
  "version": "0.1.0"
